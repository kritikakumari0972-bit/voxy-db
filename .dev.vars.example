# Required for Google Sign-In to the VoxyDB management console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Required only when enabling the optional Google Drive record mirror.
# Generate a unique random value (at least 32 characters).
DRIVE_TOKEN_ENCRYPTION_KEY=generate-a-random-secret-with-at-least-32-characters
